# LocalStack credentials for the demo runtime.
# Fake by design; LocalStack accepts any values. The point is that real-AWS
# runs swap only this file (plus the backend endpoint config), which is the
# portability requirement. Never put real credentials here.
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=us-east-1